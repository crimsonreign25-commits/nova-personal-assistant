# NOVA Personal Assistant Configuration

# LLM Providers (at least one required)
GROQ_API_KEY=your-groq-api-key-here
VENICE_API_KEY=your-venice-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Database (optional - falls back to local cache)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Security
ENCRYPTION_KEY=your-32-character-secret-key-here!

# Server Configuration
PORT=3000
NODE_ENV=development

# Personality Mode (jarvis or friday)
NOVA_PERSONALITY=jarvis

# Deployment Providers (optional)
VERCEL_TOKEN=your-vercel-token
NETLIFY_TOKEN=your-netlify-token
RENDER_TOKEN=your-render-token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
